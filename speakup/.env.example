# ============================================================
# SpeakUp — Azure Speech credentials
# ============================================================
# Copy this file to ".env" (without the .example) and fill in
# your real key + region.
#
# How to get them (free tier — 5 hours TTS + 5 hours STT / month):
#   1. https://portal.azure.com  →  sign in (or create a free account)
#   2. "Create a resource"  →  search "Speech"  →  Speech service
#   3. Choose:
#        Name        : speakup-speech (anything unique)
#        Region      : eastus   (recommended — best Arabic voices)
#        Pricing tier: Free F0  (5 audio hours/month, no credit card)
#   4. Open the resource  →  "Keys and Endpoint"
#   5. Copy KEY 1 → AZURE_SPEECH_KEY below
#      Copy LOCATION/REGION (e.g. "eastus") → AZURE_REGION below
# ============================================================

AZURE_SPEECH_KEY=
AZURE_REGION=eastus

# Optional: change which named voice each language uses.
# All Azure neural voices (Jordanian Arabic + American English) are listed
# here: https://learn.microsoft.com/azure/ai-services/speech-service/language-support
TTS_VOICE_AR=ar-JO-SanaNeural
TTS_VOICE_EN=en-US-JennyNeural
